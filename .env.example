# 服务器端口配置
PORT=3000

# MongoDB 数据库连接（生产环境请使用 MongoDB Atlas 或其他云服务连接串）
MONGODB_URI=mongodb://localhost:27017/ai-resume

# JWT 密钥（请使用强随机字符串，至少 32 字符）
JWT_SECRET=your-very-secure-jwt-secret-key

# DeepSeek API 密钥（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 简历 AI 分析思考模式：disabled | low | medium | high（默认 low）
# 分析超时后会自动降级为 disabled 再重试，该变量可不配置
DEEPSEEK_THINKING_MODE=low

# 应用基础 URL（可选，若不设置则从请求动态获取）
# BASE_URL=http://localhost:3000

# ────── Gitee OAuth 第三方登录配置 ──────
# 在 Gitee 开放平台 (https://gitee.com/oauth/applications) 创建应用后获取
GITEE_CLIENT_ID=your-gitee-client-id
GITEE_CLIENT_SECRET=your-gitee-client-secret
# 授权回调地址，必须与 Gitee 应用设置中的回调地址完全一致
# 即 Gitee 授权完成后重定向到的地址，指向后端 callback 接口
GITEE_REDIRECT_URI=http://localhost:3000/api/v1/auth/gitee/callback
# 前端 OAuth 回调页地址（后端处理完 OAuth 后会 302 重定向到此页面）
# token 通过 URL fragment 传递，前端从 window.location.hash 中解析
GITEE_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/gitee/callback
# 权限范围，多个 scope 用空格分隔（user_info 为获取用户基本信息）
GITEE_SCOPE=user_info

# OAuth 令牌加密密钥（AES-256，32 字符以上随机字符串）
# 生产环境必须设置！用于加密存储第三方平台 access_token
# 开发环境可留空，令牌将以明文存储（不推荐）
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Node 环境
NODE_ENV=development

# ────── GitHub OAuth 第三方登录配置 ──────
# 在 GitHub Settings > Developer settings > OAuth Apps 中创建应用获取
# 文档: https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps
# 注意: Authorization callback URL 必须设置为 GITHUB_REDIRECT_URI 的值

# GitHub OAuth App 的 Client ID
GITHUB_CLIENT_ID=your_github_client_id

# GitHub OAuth App 的 Client Secret（请妥善保管，不要泄露）
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth 回调地址（GitHub 应用设置中的 Authorization callback URL 必须与此一致）
# 格式: http://your-domain:port/api/v1/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

# 授权范围（scope），多个用空格分隔
# read:user - 读取用户基本信息
# user:email - 读取用户邮箱（即使设为私有）
GITHUB_SCOPE=read:user user:email

# 前端 OAuth 回调页地址（后端处理完 OAuth 后 302 重定向到此页面）
# JWT token 通过 URL fragment (#token=xxx) 传递，不会出现在服务器日志中
GITHUB_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/github/callback

QQ_CLIENT_ID=your_qq_app_id
QQ_CLIENT_SECRET=your_qq_app_key
QQ_REDIRECT_URI=http://localhost:3000/api/v1/auth/qq/callback
QQ_SCOPE=get_user_info
QQ_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/qq/callback
